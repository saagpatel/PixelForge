{
	"name": "pixelforge",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"typecheck": "tsc --noEmit",
		"rust:check": "cargo check --manifest-path src-tauri/Cargo.toml",
		"test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --lib",
		"test:frontend": "vitest run",
		"test": "pnpm test:rust && pnpm test:frontend",
		"verify": "bash .codex/scripts/run_verify_commands.sh",
		"release:smoke": "pnpm verify && pnpm tauri build --debug",
		"tauri": "tauri",
		"prepare": "husky",
		"commit": "cz",
		"commitlint": "commitlint",
		"perf:bundle": "node scripts/perf/bundle-report.mjs",
		"perf:build": "node scripts/perf/measure-build-time.mjs",
		"perf:assets": "bash scripts/perf/check-assets.sh",
		"perf:memory": "node --expose-gc scripts/perf/memory-smoke.mjs",
		"perf:summary": "node scripts/perf/summarize.mjs",
		"lint-staged": "lint-staged"
	},
	"dependencies": {
		"@tauri-apps/api": "2.10.1",
		"@tauri-apps/plugin-dialog": "^2.7.1",
		"@tauri-apps/plugin-fs": "^2.5.1",
		"@tauri-apps/plugin-opener": "^2.5.4",
		"lucide-react": "^1.21.0",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"zustand": "^5.0.14"
	},
	"devDependencies": {
		"@commitlint/cli": "^19.8.1",
		"@commitlint/config-conventional": "^19.8.1",
		"@commitlint/cz-commitlint": "^19.8.1",
		"@lhci/cli": "^0.15.1",
		"@tailwindcss/vite": "^4.3.1",
		"@tauri-apps/cli": "2.10.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^4.7.0",
		"commitizen": "^4.3.2",
		"husky": "^9.1.7",
		"jsdom": "^28.1.0",
		"lint-staged": "^16.4.0",
		"prettier": "^3.8.5",
		"tailwindcss": "^4.3.1",
		"typescript": "~5.8.3",
		"vite": "^7.3.6",
		"vitest": "^4.1.9"
	},
	"config": {
		"commitizen": {
			"path": "@commitlint/cz-commitlint"
		}
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx,mjs,cjs,json,md,css,scss,yml,yaml}": [
			"prettier --write"
		]
	}
}
